   <property name="styleSheet">
    <string notr="true">QPushButton {
    /* Remove o fundo e as bordas padrão */
    background-color: transparent;
    border: none;
    
    /* Estiliza o texto como um link */
    color: #0066cc;
    text-align: left;
    font-size: 14px;
}

QPushButton:hover {
    /* Efeito de sublinhado ao passar o mouse */
    text-decoration: underline;
    color: #004499;
}

QPushButton:pressed {
    /* Cor diferente quando o botão for clicado */
    color: #551a8b;
}
</string>
