   <property name="styleSheet">
    <string notr="true">/* Estado Normal do Botão */
QPushButton {
    background-color: #2980b9; /* Azul vibrante */
    color: white;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    border-radius: 8px; /* Cantos arredondados */
    padding: 8px 16px;
    border: none;
}

/* Quando o mouse passa por cima (Hover) */
QPushButton:hover {
    background-color: #3498db; /* Azul mais claro */
}

/* Quando o botão é clicado (Pressed) */
QPushButton:pressed {
    background-color: #1f618d; /* Azul mais escuro */
    padding-top: 10px; /* Efeito visual de afundar */
    padding-left: 18px;
}

/* Quando o botão está desativado (Disabled) */
QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}</string>
